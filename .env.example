# The default scripted provider never calls a model or costs money.
AGENTPROOF_DB=data/agentproof.sqlite3
# Optional OpenAI-compatible local or cloud endpoint. Configure locally; never commit keys.
AGENTPROOF_BASE_URL=http://127.0.0.1:11434/v1
AGENTPROOF_MODEL=
AGENTPROOF_API_KEY=
AGENTPROOF_TIMEOUT_SECONDS=20
AGENTPROOF_MAX_TOKENS=512
AGENTPROOF_DISABLE_THINKING=false
AGENTPROOF_MODEL_REVISION=unrecorded
# Optional OTLP HTTP base endpoint, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Local demo is unauthenticated: bind to 127.0.0.1; do not expose to Internet.
